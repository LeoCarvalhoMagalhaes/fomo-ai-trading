# Copie para .env (na raiz do projeto) e preencha só o que quiser usar. Nada aqui é obrigatório.
# Nunca coloque aqui credenciais da FOMO: o app não usa nem aceita.

# Chave Demo gratuita da CoinGecko (aumenta o limite do GeckoTerminal). Com ela, suba FOMOAI_GECKO_RPM para 25.
# FOMOAI_COINGECKO_DEMO_KEY=
# FOMOAI_GECKO_RPM=6

# Limites de chamadas por minuto (padrões conservadores)
# FOMOAI_DEX_RPM=60
# FOMOAI_GOPLUS_RPM=20

# Telegram (integração futura, desligada por padrão): token do bot e id do chat
# FOMOAI_TELEGRAM_BOT_TOKEN=
# FOMOAI_TELEGRAM_CHAT_ID=

# Pasta de dados (banco SQLite, logs, relatórios de backtest)
# FOMOAI_DATA_DIR=C:\caminho\para\dados

# --- Publicação online (Render). No uso local, deixe tudo isto vazio. ---
# FOMOAI_ENV=production            # exige FOMOAI_PASSWORD e manda os logs para o painel do Render
# FOMOAI_PASSWORD=                  # senha da tela de login do site
# FOMOAI_DB_URL=                    # Postgres do Supabase (pooler de sessão, porta 5432)
# FOMOAI_CORS_ORIGINS=https://leocarvalhomagalhaes.github.io
